{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/asset_manifest",
  "title": "Asset Manifest",
  "description": "Inventory of generated/sourced assets produced by the Asset Generator, supporting v1.0 and v2.0.",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "type": "string", "enum": ["1.0", "2.0"] },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "id": { "type": "string" },
          "asset_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "image", "video", "audio", "narration", "music", "sfx", "diagram",
              "animation", "3d_asset", "3d_world", "code_snippet", "subtitle",
              "font", "lut", "presenter_video", "screen_recording", "screenshot",
              "chart", "broll", "generated_broll_video",
              "sourced_image", "sourced_clip", "sandbox_capture", "presenter_matte",
              "presenter_loop", "onboarding_source"
            ]
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "image", "video", "audio", "narration", "music", "sfx", "diagram",
              "animation", "3d_asset", "3d_world", "code_snippet", "subtitle",
              "font", "lut", "presenter_video", "screen_recording", "screenshot",
              "chart", "broll", "generated_broll_video",
              "sourced_image", "sourced_clip", "sandbox_capture", "presenter_matte",
              "presenter_loop", "onboarding_source"
            ]
          },
          "path": { "type": "string", "description": "Relative path within the pipeline project directory" },
          "source_tool": { "type": "string" },
          "provider_id": { "type": "string" },
          "provider": { "type": "string" },
          "runtime": { "type": "string", "enum": ["local", "manual_import", "cloud", "api", "local_gpu"] },
          "source_type": { "type": "string" },
          "source_reference": { "type": "string" },
          "scene_id": { "type": "string" },
          "scene_ids": { "type": "array", "items": { "type": "string" } },
          "beat_ids": { "type": "array", "items": { "type": "string" } },
          "sha256": { "type": "string" },
          "prompt": { "type": "string", "description": "Generation prompt if AI-generated" },
          "prompt_hash": { "type": "string" },
          "seed": { "type": "integer" },
          "model": { "type": "string" },
          "model_id": { "type": "string" },
          "cost_usd": { "type": "number", "minimum": 0 },
          "cost_estimate_usd": { "type": "number", "minimum": 0 },
          "actual_cost_usd": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "resolution": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "fps": { "type": "number" },
          "sample_rate": { "type": "integer" },
          "channels": { "type": "integer" },
          "audio_tracks": { "type": "integer" },
          "audio_policy": { "type": "string", "enum": ["keep", "mute", "replace", "mix"] },
          "rights_status": { "type": "string" },
          "license": { "type": "string" },
          "original_url": { "type": "string" },
          "source_url": { "type": "string" },
          "attribution": { "type": "string" },
          "retrieved_at": { "type": "string" },
          "identity_transform": { "type": "string", "enum": ["beautified", "none"], "description": "Presenter assets must be 'beautified' (topic-tutorial spec D3)." },
          "profile_id": { "type": "string" },
          "alignment_method": { "type": "string", "enum": ["forced", "heuristic"] },
          "presenter_status": { "type": "string" },
          "format": { "type": "string" },
          "mime_type": { "type": "string" },
          "status": { "type": "string" },
          "generation_status": { "type": "string" },
          "validation_status": { "type": "string" },
          "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "subtype": { "type": "string" },
          "generation_summary": { "type": "string" },
          "voice_performance": {
            "type": "object",
            "properties": {
              "provider_settings": { "type": "object" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "description": "Sourced media must carry its rights record (spec §5.4b).",
            "if": { "required": ["type"], "properties": { "type": { "enum": ["sourced_image", "sourced_clip"] } } },
            "then": { "required": ["rights_status", "license", "source_url", "attribution", "retrieved_at"] }
          },
          {
            "if": { "required": ["asset_type"], "properties": { "asset_type": { "enum": ["sourced_image", "sourced_clip"] } } },
            "then": { "required": ["rights_status", "license", "source_url", "attribution", "retrieved_at"] }
          }
        ]
      }
    },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "estimated_total_cost_usd": { "type": "number", "minimum": 0 },
    "actual_total_cost_usd": { "type": "number", "minimum": 0 },
    "provider_usage": { "type": "array" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
